{
  "hosting": [
    {
      "target": "app",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin-allow-popups"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/follow",
          "destination": "https://travellers1969.web.app/",
          "type": 301
        },
        {
          "source": "/follow/:slug",
          "destination": "https://travellers1969.web.app/:slug",
          "type": 301
        }
      ]
    },
    {
      "target": "follow",
      "public": "follow-site",
      "ignore": [
        "**/.*"
      ],
      "rewrites": [
        {
          "source": "/og/**",
          "function": {
            "functionId": "followOg",
            "region": "europe-west1"
          }
        },
        {
          "source": "/*",
          "function": {
            "functionId": "followPage",
            "region": "europe-west1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}